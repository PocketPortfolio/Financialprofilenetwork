packages/importer/dist/
.vite/
.vercel/
.next/

.env
.env.*
!.env.example

# Generated at build-time (do not commit)
public/sitemap*.xml
public/sitemap.xml
public/sw.js

# Test / tooling output
coverage/
*.tsbuildinfo
test-results/
ui-audit/
playwright-report/
exports/

