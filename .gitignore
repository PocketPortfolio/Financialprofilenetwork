.env*.local
tmp-*
tmp-*.json
tmp-*.mjs
qwen-test-demo.txt
scripts/.wave2-fw-tmp.json
dependabot-alerts.json
npm-audit*.json
npm-audit-*.json

# --- Ship surface boundary (2026-10-12) ---
# Product git/Vercel = runtime only. Ops / business / document assets stay local or Drive.
# SSOT: docs/command/ship-surface-boundary-2026-10-12.md

# Local Command / org / ops packs (Drive / private). Already-tracked files stay tracked;
# new untracked Command assets must not enter product PRs.
docs/command/**
!docs/command/
!docs/command/ship-surface-boundary-2026-10-12.md
docs/architecture/_harness-runs/

# Outreach / commercial leave-behinds
docs/outreach/

# Seed / investor document assets
docs/seed/

# Media working packages + raw footage (Google Drive)
docs/media/

