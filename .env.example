VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=

# Microsoft identity (Firebase Auth provider microsoft.com) + OneDrive Sovereign Sync (MSAL)
# Platform: Azure app = Accounts in any org + personal; redirect = Firebase __/auth/handler
# SPA redirect (required in Azure): http://localhost:3001  (exact, no trailing slash)
# Optional blank forwarder (only after registering it in Azure):
# NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=http://localhost:3001/onedrive-auth.html
# NEXT_PUBLIC_MICROSOFT_REDIRECT_URI=
# Put real values only in .env*.local (gitignored). Never commit client secrets here —
# Firebase Microsoft provider secret stays in Firebase Console only.
# NEXT_PUBLIC_MICROSOFT_CLIENT_ID=
# NEXT_PUBLIC_MICROSOFT_TENANT_ID=   # optional reference; runtime uses /common
# Optional if Firebase uses a different Azure app than MSAL OneDrive:
# NEXT_PUBLIC_MICROSOFT_AUTH_CLIENT_ID=

# Cron: GET /api/cron/viral-moment-blast (Bearer CRON_SECRET or x-vercel-cron)
# CRON_SECRET=
# RESEND_API_KEY=
# Optional caps: VIRAL_MOMENT_BLAST_MAX_SENDS=50 VIRAL_MOMENT_BLAST_MAX_EVALUATED=5000
# Optional from override (defaults in lib/marketing): VIRAL_ROUTE_TO_RISE_FROM=
# EMAIL_LOGO_URL=

# Feedback substrate (Phase 1)
# Sole operational inbox (P0 TO + default From): ai@pocketportfolio.app
# FEEDBACK_ENGINEERING_EMAIL=ai@pocketportfolio.app
# FEEDBACK_ALERT_FROM=Pocket Portfolio Alerts <ai@pocketportfolio.app>
# FEEDBACK_ANON_PEPPER=  # prod: set distinct pepper; local may fall back to ENCRYPTION_SECRET
# FEEDBACK_P0_WEBHOOK_URL=  # optional Slack/Discord for P0 alerts
# NEXT_PUBLIC_FEEDBACK_DEV_FORCE_EMAILS=  # local/dev only — OMIT in Vercel production
